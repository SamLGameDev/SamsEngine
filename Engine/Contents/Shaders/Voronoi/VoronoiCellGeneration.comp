void TriangulateRawCell(const in Cell InCell, const in uint index)
{
    //CutCells[index].NumInds = 0;
    //CutCells[index].NumVerts = 0;
    CutCells[index].NumFaces = 0;

    for (uint i = 0; i < InCell.NumFaces; i++)
    {
        if (InCell.Faces[i].NumVerts < 3) continue;
        CutCells[index].Faces[CutCells[index].NumFaces].NumVerts = 0;
        for (uint j = 0; j < InCell.Faces[i].NumVerts; j++)
        {
            if (Contains(InCell.Faces[i].Verts[j], CutCells[index].Faces[CutCells[index].NumFaces])) continue;
            AddFaceVert(CutCells[index].Faces[CutCells[index].NumFaces], InCell.Faces[i].Verts[j]);
        }

        if (CutCells[index].Faces[CutCells[index].NumFaces].NumVerts < 3) continue;
        vec3 center = GetPlaneCenter(CutCells[index].Faces[CutCells[index].NumFaces]);
        CutCells[index].Faces[CutCells[index].NumFaces] = OrderByAngle(CutCells[index].Faces[CutCells[index].NumFaces], center, GetPlaneNormal(CutCells[index].Faces[CutCells[index].NumFaces], center));
        CutCells[index].NumFaces++;
        //for (uint j = 1; j + 1 < newFace.NumVerts; j++)
        //{
          //  AddOrMakeInd(index, newFace.Verts[0]);
           // AddOrMakeInd(index, newFace.Verts[j]);
           // AddOrMakeInd(index, newFace.Verts[j+1]);
        //}
    }
}


void main()
{
    uint index = gl_GlobalInvocationID.x;

    if (index >= NumPoints) return;
    
    vec3 point = Points[index];
    
    Cell cell;
    cell.NumFaces = 0;

    for (uint i = 0; i < 6; i++)
    {
        cell.Faces[cell.NumFaces] = BoundingBoxFaces[i];
        cell.NumFaces++;
    }
    
    for (uint i = 0; i < NumPoints; i++)
    {
        if (i == index) continue;
        const vec3 ComparedPoint = Points[i];
        vec3 normal, center;
        DefinePlane(point, ComparedPoint, normal, center);
        cell = ClipCellByFace(cell, center, normal, i);
    }
   // CutCells[index] = cell;
    TriangulateRawCell(cell, index);
    NumCells++;

}
