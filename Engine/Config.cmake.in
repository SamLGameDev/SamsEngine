@PACKAGE_INIT@

# Prefer build-tree targets if available
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/EngineCoreTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/EngineCoreTargets.cmake")
elseif(EXISTS "${CMAKE_CURRENT_LIST_DIR}/../EngineCoreTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/../EngineCoreTargets.cmake")
endif()

check_required_components(EngineCore)

include(CMakeFindDependencyMacro)
find_dependency(ZLIB REQUIRED)